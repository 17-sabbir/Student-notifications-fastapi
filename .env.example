DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_notifications

# Set this to the public path prefix your reverse proxy forwards to the
# backend WITHOUT stripping it (e.g. nginx location /notifications/ ->
# proxy_pass http://127.0.0.1:8000;). Leave empty when the backend is
# reached directly (local development).
# Production: API_ROOT_PATH=/notifications
API_ROOT_PATH=

FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
FIREBASE_PROJECT_ID=notifications-app-b29a7

CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://10.0.2.2:8080

RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_OTP=5/15minutes
RATE_LIMIT_RESEND=1/minute
NOTIFICATION_RENOTIFY_INTERVAL_MINUTES=2
NOTIFICATION_SCHEDULER_INTERVAL_SECONDS=10
FCM_SEND_CONCURRENCY=20
